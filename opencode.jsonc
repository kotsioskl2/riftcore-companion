{
  "$schema": "https://opencode.ai/config.json",
  "model": "riftcore/gpt-oss-20b",
  "default_agent": "architect",
  "providers": {
    "riftcore": {
      "name": "RiftCore AUP AMD R9700",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "GPT-OSS-20B MXFP4 (AUP Radeon AI PRO R9700)",
          "modelID": "/home/jovyan/models/gpt-oss-20b-MXFP4.gguf",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "background": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": "20%"
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  }
}
