{
  "name": "riftcore-companion",
  "version": "2.0.4",
  "description": "Minimalist Red & Blue League of Legends companion & overlay",
  "main": "electron/main.js",
  "author": "RiftCore Team",
  "scripts": {
    "start": "electron .",
    "dev:electron": "electron .",
    "package:exe": "npm run build && electron-packager . RiftCore --platform=win32 --arch=x64 --out=dist_electron --overwrite --icon=dist/icon.ico --prune=true --ignore=\"^/(riftcore-native|installer|installer_output|RiftCore_Rust_Portable|PowerShell|src|\\.git)\"",
    "dev": "vite",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:rust": "build_rust.bat",
    "build:all": "build_all.bat",
    "bump": "node scripts/bump_version.mjs",
    "publish:release": "powershell -ExecutionPolicy Bypass -File scripts/publish_release.ps1",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "ws": "^8.22.0"
  }
}
